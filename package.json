{
  "name": "arkvault",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:remote": "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=.ts.net vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p ./src/service-worker",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose -f docker-compose.dev.yaml -p arkvault-dev up -d",
    "db:down": "docker compose -f docker-compose.dev.yaml -p arkvault-dev down",
    "db:migrate": "kysely migrate"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/material-symbols": "^1.2.95",
    "@noble/hashes": "^2.4.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-virtual": "^3.13.40",
    "@testcontainers/postgresql": "^12.2.0",
    "@trpc/client": "^11.19.0",
    "@types/file-saver": "^2.0.7",
    "@types/ms": "^2.1.0",
    "@types/node-schedule": "^2.1.8",
    "@types/pg": "^8.23.1",
    "axios": "^1.20.0",
    "dexie": "^4.4.6",
    "es-hangul": "^2.4.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "exifreader": "^4.48.0",
    "file-saver": "^2.0.5",
    "globals": "^17.13.0",
    "heic2any": "^0.0.4",
    "kysely-ctl": "^0.21.0",
    "lru-cache": "^11.5.3",
    "mime": "^4.1.0",
    "p-limit": "^7.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@trpc/server": "^11.19.0",
    "argon2": "^0.45.1",
    "kysely": "^0.29.6",
    "ms": "^2.1.3",
    "node-schedule": "^2.1.1",
    "pg": "^8.23.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^22.17.0",
    "pnpm": "^12.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#trpc/*": "./src/trpc/*",
    "#workers/*": "./src/workers/*"
  }
}
