    "pg": "^8.22.0",
    "superjson": "^2.2.6",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^22.0.0",
    "pnpm": "^10.0.0"
  }
}
