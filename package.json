{
  "name": "arkvault",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "db:up": "docker compose -f docker-compose.dev.yaml -p arkvault-dev up -d",
    "db:down": "docker compose -f docker-compose.dev.yaml -p arkvault-dev down",
    "db:migrate": "kysely migrate"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/material-symbols": "^1.2.85",
    "@noble/hashes": "^2.2.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tanstack/svelte-virtual": "^3.13.32",
    "@trpc/client": "^11.18.0",
    "@types/file-saver": "^2.0.7",
    "@types/ms": "^0.7.34",
    "@types/node-schedule": "^2.1.8",
    "@types/pg": "^8.20.0",
    "autoprefixer": "^10.5.3",
    "axios": "^1.18.1",
    "dexie": "^4.4.4",
    "es-hangul": "^2.4.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "exifreader": "^4.41.0",
    "file-saver": "^2.0.5",
    "globals": "^17.7.0",
    "heic2any": "^0.0.4",
    "kysely-ctl": "^0.21.0",
    "lru-cache": "^11.5.2",
    "mime": "^4.1.0",
    "p-limit": "^7.3.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.5",
    "svelte-check": "^4.7.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.4"
  },
  "dependencies": {
